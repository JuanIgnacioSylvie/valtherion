{
  "name": "valtherion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Valtherion — maqueta 3D de Aurion (capital medieval)",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "city:generate": "tsx tools/generate-city.ts",
    "plano:fetch": "tsx tools/download-glade.ts",
    "plano:placeholder": "tsx tools/make-placeholder.ts",
    "plano:from-raw": "tsx tools/from-raw.ts",
    "plano:tile": "tsx tools/tile-plano.ts",
    "datos:build": "tsx tools/build-datos.ts",
    "datos:extract": "tsx tools/extract-ink.ts",
    "datos:import-orig": "tsx tools/import-orig.ts",
    "hoy:osm": "tsx tools/bake-hoy-osm.ts",
    "epocas:bake": "tsx tools/bake-epocas.ts",
    "bootstrap": "pnpm plano:from-raw && pnpm plano:tile && pnpm datos:extract && pnpm hoy:osm",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
